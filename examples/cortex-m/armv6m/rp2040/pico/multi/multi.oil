OIL_VERSION = "4.0";

IMPLEMENTATION trampoline {

    /* This fix the default STACKSIZE of tasks */
    TASK {
        UINT32 STACKSIZE = 800 ;
    } ;

};

CPU blink {

  APPMODE OsAppMode {};

  /* ==========================================================================
   *    OS
   */

  OS config {
    GDBCOMMANDS = TRUE;
    STATUS = EXTENDED;
    NUMBER_OF_CORES =  2;
    BUILD = TRUE {
      TRAMPOLINE_BASE_PATH = "../../../../../..";
      APP_SRC = "multi.c";
      APP_NAME = "multi_exe";
      CFLAGS  = "-O3"; 
      LDFLAGS = "-Map=multi.map";
      COMPILER = "arm-none-eabi-gcc";
      ASSEMBLER = "arm-none-eabi-as";
      LINKER = "arm-none-eabi-ld";
      COPIER = "arm-none-eabi-objcopy";
      SYSTEM = CMAKE {VSCODE=TRUE;};
    };
    SYSTEM_CALL = TRUE;
    MEMMAP = TRUE {
      COMPILER = gcc;
      LINKER = gnu_ld { SCRIPT = "script.ld"; };
      ASSEMBLER = gnu_as;
      MEMORY_PROTECTION = FALSE;
    };
  };

  /* ==========================================================================
   *    APPLICATION
   */


  APPLICATION application1 {
    TASK = t1_app1;
    COUNTER = SystemCounter;
    ALARM = alarm_t1_app1;
    CORE = 0;
  };

  APPLICATION application2 {
    TASK = t1_app2;
    COUNTER = SystemCounter2;
    ALARM = alarm_t1_app2;
    CORE = 1;
  };

  /* ==========================================================================
   *    ALARM
   */
  COUNTER SystemCounter2 {
    SOURCE = SysTick;
   };

  ALARM alarm_t1_app1 {
    COUNTER = SystemCounter2;
    ACTION = ACTIVATETASK { TASK = t1_app1;};
    AUTOSTART = TRUE {
      APPMODE = OsAppMode;
      ALARMTIME = 100;
      CYCLETIME = 75;
    };
  };
  
  ALARM alarm_t1_app2 {
    COUNTER = SystemCounter2;
    ACTION = ACTIVATETASK { TASK = t1_app2;};
    AUTOSTART = TRUE {
      APPMODE = OsAppMode;
      ALARMTIME = 200;
      CYCLETIME = 200;
    };
  };

  /* ==========================================================================
   *    TASK
   */

  TASK t1_app1 {
    ACTIVATION = 1;
    PRIORITY = 5;
    SCHEDULE = FULL;
    ACCESSING_APPLICATION = application1;
    AUTOSTART = FALSE;
    USEFLOAT = FALSE;
  };

  TASK t1_app2 {
    ACTIVATION = 1;
    PRIORITY = 5;
    SCHEDULE = FULL;
    ACCESSING_APPLICATION = application2;
    AUTOSTART = FALSE;
    USEFLOAT = FALSE;
  };
  IOC test_multicore {
    DATATYPENAME uint32 {
      DATATYPEPROPERTY = DATA;
    };
    SEMANTICS = LAST_IS_BEST{
      INIT_VALUE_SYMBOL = AUTO ;
    };
    SENDER core0 {
      SND_OSAPPLICATION = application1 ;
    };
    RECEIVER core1 {
      RCV_OSAPPLICATION = application2;
      ACTION = NONE ;
    };
  };

};

