#
# Set of GDB user defined commands for debugging application blink
# Automatically generated by goil on Www Mmm dd hh:mm:ss yyyy
# from root OIL file multi.oil
# 
# Trampoline RTOS
#

define tr_print_internal_rez_name
  if $arg0 == 0
    printf "NONE"
  end
end

define tr_print_rez_name
  if $arg0 == &res_sched_rez_desc
    printf "RES_SCHEDULER"
  end
end

define tr_print_held_rez
  tr_print_rez_name $arg0
  if $arg0 != 0
    tr_print_held_rez $arg0->next_res
  end
end

define tr_print_task_state
  set $_state = $arg0 & 0x3
  if $_state == 0
    printf "SUSPENDED"
  else
    if $_state == 1
      printf "READY"
    else
      if $_state == 2
        printf "RUNNING"
      else
        if $_state == 3
          printf "WAITING"
        end
      end
    end
  end
end

define tr_print_event
  set $_tr_displayed_event_count = 0
  set $_tr_task_events = $arg0
  if $_tr_task_events != 0
    printf "%d",$_tr_task_events
    set $_tr_displayed_event_count = $_tr_displayed_event_count + 1
  end
  if $_tr_displayed_event_count == 0
    printf "<NONE>"
  end
end

define _t1_app1
  printf "Task t1_app1 (id = %d, BASIC):\n", t1_app1_task_stat_desc.id
  printf "\tstate             = "
  tr_print_task_state t1_app1_task_desc.state
  printf "\n\tpriority          = %d/%d\n",t1_app1_task_desc.priority >> 2,t1_app1_task_stat_desc.base_priority
  printf "\tactivate_count    = %d/%d\n",t1_app1_task_desc.activate_count,t1_app1_task_stat_desc.max_activate_count
  printf "\tinternal_resource = "
  tr_print_internal_rez_name t1_app1_task_stat_desc.internal_resource
  printf "\n"
  printf "\tresources         = [ "
  tr_print_held_rez t1_app1_task_desc.resources
  printf "]\n"
end

document _t1_app1
  Displays the task descriptor of _t1_app1 synthetically
end

define b_t1_app1
  b t1_app1_function
end

document b_t1_app1
  Places a breakpoint on the first instruction of the task _t1_app1
end

