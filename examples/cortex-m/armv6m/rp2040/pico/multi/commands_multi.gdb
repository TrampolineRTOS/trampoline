define p_kernel
  printf "tpl_kern:\n"
  printf "\trunning       = "
  tr_print_task_name_from_id tpl_kern[$arg0]->running_id
  printf "\n\telected       = "
  tr_print_task_name_from_id tpl_kern[$arg0]->elected_id
  printf "\n\tneed schedule = %d\n",tpl_kern[$arg0]->need_schedule
  printf "\tneed switch   = %d\n",tpl_kern[$arg0]->need_switch & 1
  printf "\tneed save     = %d\n",tpl_kern[$arg0]->need_switch >> 1

  if tpl_kern[$arg0]->running_id != -1
    if tpl_kern[$arg0]->s_running != tpl_stat_proc_table[tpl_kern[$arg0]->running_id]
      printf "warning: tpl_kern pointer to static running proc descriptor does not correspond to running id\n"
    end
    if tpl_kern[$arg0]->running != tpl_dyn_proc_table[tpl_kern[$arg0]->running_id]
      printf "warning: tpl_kern pointer to dynamic running proc descriptor does not correspond to running id\n"
    end
  end
  if tpl_kern[$arg0]->elected_id != -1
    if tpl_kern[$arg0]->s_elected != tpl_stat_proc_table[tpl_kern[$arg0]->elected_id]
      printf "warning: tpl_kern pointer to static elected proc descriptor does not correspond to elected id\n"
    end
    if tpl_kern[$arg0]->elected != tpl_dyn_proc_table[tpl_kern[$arg0]->elected_id]
      printf "warning: tpl_kern pointer to dynamic elected proc descriptor does not correspond to elected id\n"
    end
  end
end

define indentby
  set $_indent = $arg0 + 2
  while $_indent > 0 
    printf " "
    set $_indent = $_indent - 1
  end
end

define p_ready_list_node
  indentby $arg2
  printf "[%d](%d,%d) ",tpl_ready_list[$arg0][$arg1].key,tpl_ready_list[$arg0][$arg1].key >> 2,tpl_ready_list[$arg0][$arg1].key & 3
  tr_print_task_name_from_id tpl_ready_list[$arg0][$arg1].id
  printf "\n"
  if ($arg1<<1) <= tpl_ready_list[$arg0][0].key
    p_ready_list_node $arg0 ($arg1<<1) ($arg2+2)
  end
  if (($arg1<<1)+1) <= tpl_ready_list[$arg0][0].key
    p_ready_list_node $arg0 (($arg1<<1)+1) ($arg2+2)
  end
end

define p_ready_list
  printf "ready_list [%d]:\n", tpl_ready_list[$arg0][0].key
  if tpl_ready_list[$arg0][0].key > 0
    p_ready_list_node $arg0 1 0
  else
    printf "EMPTY\n"
  end
end

define p_k0
  p_kernel 0
  p_ready_list 0
end

define p_k1
  p_kernel 1
  p_ready_list 1
end