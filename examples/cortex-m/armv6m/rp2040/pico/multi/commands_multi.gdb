define tr_print_alarm_name
  if $arg0 == &alarm_t1_app1_alarm_desc
    printf "alarm_t1_app1"
  end
  if $arg0 == &alarm_t1_app2_alarm_desc
    printf "alarm_t1_app2"
  end
end

define tr_print_alarm_list
  if $arg0 != $arg1
    tr_print_alarm_name $arg0
    printf "(%d) ",$arg0->date
    tr_print_alarm_list $arg0->next_to $arg1
  end
end

define _Core1_counter0
  printf "Counter Core1_counter0:\n"
  printf "\tticks per base    = %d\n",Core1_counter0_counter_desc.ticks_per_base
  printf "\tmax allowed value = %d\n",Core1_counter0_counter_desc.max_allowed_value
  printf "\tmin cycle         = %d\n",Core1_counter0_counter_desc.min_cycle
  printf "\tcurrent tick      = %d\n",Core1_counter0_counter_desc.current_tick
  printf "\tcurrent date      = %d\n",Core1_counter0_counter_desc.current_date
  printf "\talarms            = [ "
  tr_print_alarm_list Core1_counter0_counter_desc.next_to 0
  tr_print_alarm_list Core1_counter0_counter_desc.first_to Core1_counter0_counter_desc.next_to
  printf "]\n"
end

document _Core1_counter0
  Displays the counter descriptor of _Core1_counter0
end

