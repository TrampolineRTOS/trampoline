define b_t1_app2
  b t1_app2_function
end

document b_t1_app2
  Places a breakpoint on the first instruction of the task _t1_app2
end


define tr_print_task_name_from_id
  set $_found = 0
  if $arg0 == 0
    printf "t1_app1"
    set $_found = 1
  end
  if $arg0 == 1
    printf "t1_app2"
    set $_found = 1
  end
  if $arg0 == 2
    printf "IDLE0"
    set $_found = 1
  end
  if $arg0 == 3
    printf "IDLE1"
    set $_found = 1
  end
  if $_found == 0
    printf "NONE"
  end
end


define _res_sched
  printf "Resource res_sched (id = %d, STANDARD):\n",res_sched
  printf "\tceiling priority    = %d\n",res_sched_rez_desc.ceiling_priority
  printf "\towner               = "
  tr_print_task_name_from_id res_sched_rez_desc.owner
  printf "\n"
  if res_sched_rez_desc.owner != -1
  printf "\towner prev priority = %d\n",res_sched_rez_desc.owner_prev_priority >> 2
  end
end

document _res_sched
  Displays the resource descriptor of _res_sched synthetically
end

define tr_print_counter_name
  if $arg0 == &Core1_counter0_counter_desc
    printf "Core1_counter0"
  end
  if $arg0 == &SystemCounter_counter_desc
    printf "SystemCounter"
  end
end

define tr_print_alarm_state
  if $arg0 == 0
    printf "SLEEP"
  else
    if $arg0 == 1
      printf "ACTIVE"
    else
      if $arg0 == 2
        printf "AUTOSTART"
      else
        printf "?"
      end
    end
  end
end



define tr_print_event_name_for_mask
end

define tr_print_alarm_action
  set $_action_ptr = ((tpl_action*)$arg0)->action
  if ((int)$_action_ptr & ~1) == tpl_action_activate_task
    printf "ActivateTask("
    tr_print_task_name_from_id ((tpl_task_activation_action*)$arg0)->task_id
    printf ")"
  end
  if ((int)$_action_ptr & ~1) == tpl_action_callback
    output ((tpl_callback_action*)$arg0)->callback
  end
end

define _alarm_t1_app1
  printf "Alarm alarm_t1_app1 (id = %d):\n",alarm_t1_app1
  printf "\tcounter = "
  tr_print_counter_name alarm_t1_app1_alarm_desc.stat_part->counter
  printf "(%d)\n",alarm_t1_app1_alarm_desc.stat_part->counter->current_date
  printf "\tstate   = "
  tr_print_alarm_state alarm_t1_app1_alarm_desc.state
  printf "\n"
  if alarm_t1_app1_alarm_desc.state == 1
    printf "\tdate    = %d\n",alarm_t1_app1_alarm_desc.date
    if alarm_t1_app1_alarm_desc.cycle != 0
      printf "\tcycle   = %d\n",alarm_t1_app1_alarm_desc.cycle
    end
  end
  printf "\taction  = "
  tr_print_alarm_action ((tpl_alarm_static*)alarm_t1_app1_alarm_desc.stat_part)->action
  printf "\n"
end

document _alarm_t1_app1
  Displays the alarm descriptor of _alarm_t1_app1 synthetically
end

