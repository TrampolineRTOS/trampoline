  printf "\n\tpriority          = %d/%d\n",t1_app2_task_desc.priority >> 2,t1_app2_task_stat_desc.base_priority
  printf "\tactivate_count    = %d/%d\n",t1_app2_task_desc.activate_count,t1_app2_task_stat_desc.max_activate_count
  printf "\tinternal_resource = "
  tr_print_internal_rez_name t1_app2_task_stat_desc.internal_resource
  printf "\n"
  printf "\tresources         = [ "
