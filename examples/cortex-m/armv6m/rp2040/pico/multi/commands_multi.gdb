  printf "\tmax allowed value = %d\n",SystemCounter_counter_desc.max_allowed_value
  printf "\tmin cycle         = %d\n",SystemCounter_counter_desc.min_cycle
  printf "\tcurrent tick      = %d\n",SystemCounter_counter_desc.current_tick
  printf "\tcurrent date      = %d\n",SystemCounter_counter_desc.current_date
  printf "\talarms            = [ "
  tr_print_alarm_list SystemCounter_counter_desc.next_to 0
